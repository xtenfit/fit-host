# Fit Host - Mobile Environment Variables Template
# Copy this file to .env and insert your project credentials

# Supabase Mobile Client
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-anon-publishable-key

# Optional PostHog Analytics (Safe fallback if omitted)
POSTHOG_API_KEY=phc_your_posthog_project_api_key_here
POSTHOG_HOST=https://us.i.posthog.com # Or https://eu.i.posthog.com

# PostHog source-map upload (build time only)
POSTHOG_CLI_API_KEY=your_posthog_personal_api_key_here
POSTHOG_CLI_PROJECT_ID=your_posthog_project_id_here
POSTHOG_CLI_HOST=https://us.posthog.com

# Firebase Crashlytics
# Place google-services.json in android/app/ and GoogleService-Info.plist in ios/Runner/
